@[expose] public section
set_option backward.proofsInPublic true

/-!
# The Regular `{7, 3}` Tiling and Its Dual `{3, 7}` Triangulation

We define the canonical `{7, 3}` face-incircle center set `sites37 ⊆ H2` as the orbit of `H2.origin`
under the explicit `(2, 3, 7)` hyperbolic reflection group `Delta237 = ⟨R1, R2, R3⟩ ≤ (H2 ≃ᵢ H2)`.
We also define the dual graph adjacency (`dist u v = 2 * r7`), polar frames about a site,
neighbor profiles `τ₂, τ₃, τ₄`, tip points, good sets, qualifying sites, zones `Z_m`,
and the zone substitution rule `σ(1) = 112`, `σ(2) = 12`.
-/

noncomputable section
open Classical

namespace FejesTothP7

/-- Reflection `R1` across the ray `θ = 0` from `H2.origin`. -/
def R1_237 : H2 ≃ᵢ H2 := H2.reflXAxis

/-- Reflection `R2` across the ray `θ = π / 7` from `H2.origin`. -/
def R2_237 : H2 ≃ᵢ H2 := H2.reflRay (Real.pi / 7)

/-- Reflection `R3` across the perpendicular bisector of `[origin, polarOrigin (2 * r7) 0]`. -/
def R3_237 : H2 ≃ᵢ H2 := H2.reflPerpX r7

/-- The `(2, 3, 7)` hyperbolic reflection group generated by `R1_237`, `R2_237`, `R3_237`. -/
def Delta237 : Subgroup (H2 ≃ᵢ H2) :=
  Subgroup.closure ({R1_237, R2_237, R3_237} : Set (H2 ≃ᵢ H2))

/-- The canonical set of sites (centers of the face-incircles of `{7, 3}`, i.e. vertices of `{3, 7}`). -/
def sites37 : Set H2 :=
  {p : H2 | ∃ g ∈ Delta237, g H2.origin = p}

/-- Two sites in a site set `V` are adjacent in `{3, 7}` iff their distance equals `2 * r7`. -/
def Adj37 (u v : H2) : Prop :=
  dist u v = 2 * r7

/-- A hyperbolic polar frame at a site `v ∈ V`: an isometry `φ : H2 ≃ᵢ H2` sending `origin` to `v`
    and sending the seven rays `(2 r7, k α7)` (`k : Fin 7`) bijectively onto the neighbors of `v` in `V`. -/
structure SiteFrame (V : Set H2) (v : H2) where
  φ : H2 ≃ᵢ H2
  origin_eq : φ H2.origin = v
  nbr_mem : ∀ k : Fin 7, φ (H2.polarOrigin (2 * r7) ((k : ℝ) * α7)) ∈ V
  nbr_iff : ∀ w ∈ V, Adj37 v w ↔ ∃ k : Fin 7, w = φ (H2.polarOrigin (2 * r7) ((k : ℝ) * α7))

/-- The `k`-th neighbor (`k : ℤ`, mod 7) of `v` in a polar frame `F`. -/
def SiteFrame.nbr {V : Set H2} {v : H2} (F : SiteFrame V v) (k : ℤ) : H2 :=
  F.φ (H2.polarOrigin (2 * r7) ((k : ℝ) * α7))

/-- The point at polar coordinates `(ρ, θ)` about `v` in frame `F`. -/
def SiteFrame.polar {V : Set H2} {v : H2} (F : SiteFrame V v) (ρ θ : ℝ) : H2 :=
  F.φ (H2.polarOrigin ρ θ)

/-- The tip point `tip(v; n₁, n₂) = (ρ*, 3α/2)` in polar coordinates about `v` (where `n₀, n₁, n₂, n₃`
    sit at `0, α, 2α, 3α`). -/
def SiteFrame.tip12 {V : Set H2} {v : H2} (F : SiteFrame V v) : H2 :=
  F.polar ρ7 (3 * α7 / 2)

/-- The mirrored tip point `tip(v; n₀, n₁) = (ρ*, α/2)` in polar coordinates about `v`. -/
def SiteFrame.tip01 {V : Set H2} {v : H2} (F : SiteFrame V v) : H2 :=
  F.polar ρ7 (α7 / 2)

/-- A site `v` has profile `τ_k` relative to an unfixed set `U ⊆ V` in frame `F` if among the
    seven neighbors `F.nbr 0, ..., F.nbr 6` of `v`, precisely `0, ..., k - 1` belong to `U`. -/
def HasProfile (V : Set H2) (U : Set H2) (v : H2) (k : ℕ) (F : SiteFrame V v) : Prop :=
  ∀ j : Fin 7, F.nbr j ∈ U ↔ (j : ℕ) < k

/-- The polar region `K₂ = { (ρ, θ) | 0 < ρ < 2r, β(ρ) ≤ θ ≤ 3α - β(ρ) }` in frame `F`. -/
def SiteFrame.K2 {V : Set H2} {v : H2} (F : SiteFrame V v) : Set H2 :=
  {P : H2 | ∃ ρ θ : ℝ, 0 < ρ ∧ ρ < 2 * r7 ∧ β7 ρ ≤ θ ∧ θ ≤ 3 * α7 - β7 ρ ∧ P = F.polar ρ θ}

/-- The mirrored polar region `K₂' = { (ρ, θ) | 0 < ρ < 2r, β(ρ) - α ≤ θ ≤ 2α - β(ρ) }`. -/
def SiteFrame.K2Mirror {V : Set H2} {v : H2} (F : SiteFrame V v) : Set H2 :=
  {P : H2 | ∃ ρ θ : ℝ, 0 < ρ ∧ ρ < 2 * r7 ∧ β7 ρ - α7 ≤ θ ∧ θ ≤ 2 * α7 - β7 ρ ∧ P = F.polar ρ θ}

/-- The simple graph `{3, 7}` on the subtype `sites37` with adjacency `dist u v = 2 * r7`. -/
def graph37 : SimpleGraph sites37 where
  Adj u v := Adj37 u.1 v.1
  symm := ⟨fun _ _ h => by unfold Adj37 at *; rwa [dist_comm]⟩
  loopless := ⟨fun u h => by
    unfold Adj37 at h
    rw [dist_self] at h
    linarith [r7_pos]⟩

/-- One-vacancy packing `S = sites37 \ {c₀}` for a chosen vacancy `c₀ ∈ sites37`. -/
def oneVacancy (c₀ : H2) : Set H2 := sites37 \ {c₀}

/-- A finite subset `s ⊆ S` is good if every rearrangement of `s` in `S` is trivial. -/
def IsGood (c₀ : H2) (s : Finset H2) : Prop :=
  (s : Set H2) ⊆ oneVacancy c₀ ∧
  ∀ X : Finset H2, IsRearrangement r7 (oneVacancy c₀) s X →
    IsTrivialRearrangement (oneVacancy c₀) s X

/-- A site `c ∈ S \ s` can be joined to a good set `s` if `s ∪ {c}` is good. -/
def CanJoin (c₀ : H2) (s : Finset H2) (c : H2) : Prop :=
  IsGood c₀ (insert c s)

/-- Fixed sites relative to `s ⊆ S`: `S \ s`. -/
def FixedSites (c₀ : H2) (s : Finset H2) : Set H2 :=
  oneVacancy c₀ \ (s : Set H2)

/-- Unfixed sites relative to `s ⊆ S`: `(s : Set H2) ∪ {c₀}`. -/
def UnfixedSites (c₀ : H2) (s : Finset H2) : Set H2 :=
  (s : Set H2) ∪ {c₀}

/-- Qualifying site `q ∈ s ∪ {c}` for joining `c` to `s`: `(s ∪ {c}) \ {q}` is good. -/
def IsQualifying (c₀ : H2) (s : Finset H2) (c q : H2) : Prop :=
  q ∈ insert c s ∧ IsGood c₀ ((insert c s).erase q)

/-- The `m`-th zone `Z_m(c₀)`: sites at graph distance `m` from `c₀` in `graph37`. -/
def Zone (c₀ : sites37) (m : ℕ) : Set H2 :=
  {x : H2 | ∃ hx : x ∈ sites37, graph37.edist ⟨x, hx⟩ c₀ = (m : ENat)}

/-- Union of the first `n` zones `U_n = Z_1 ∪ ... ∪ Z_n`. -/
def ZoneUnion (c₀ : sites37) (n : ℕ) : Set H2 :=
  ⋃ m ∈ Finset.Icc 1 n, Zone c₀ m

/-- Zone vertex types (`1` or `2` inner neighbors in `Z_{m-1}`). -/
inductive ZoneType : Type
  | t1 : ZoneType
  | t2 : ZoneType
  deriving DecidableEq, Repr

/-- The substitution rule `σ(1) = 1 1 2`, `σ(2) = 1 2` on words over `{1, 2}`. -/
def sigmaStep : ZoneType → List ZoneType
  | .t1 => [.t1, .t1, .t2]
  | .t2 => [.t1, .t2]

/-- Apply `σ` to a cyclic word. -/
def sigmaWord (w : List ZoneType) : List ZoneType :=
  w.flatMap sigmaStep

/-- The canonical zone word `w_m`: `w_1 = 1^7`, `w_{m+1} = σ(w_m)`. -/
def zoneWord : ℕ → List ZoneType
  | 0 => []
  | 1 => List.replicate 7 .t1
  | m + 2 => sigmaWord (zoneWord (m + 1))

end FejesTothP7
